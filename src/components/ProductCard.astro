---
import type { Lang } from '../data/categories';
import { T, href, fmtPrice, pick } from '../i18n';
import { type Product, slugOf, priceOf, smallImg, isScene, isPhoto, swatchOf } from '../lib/products';
import { colorName } from '../data/colors';

interface Props { p: Product; lang: Lang; eager?: boolean }
const { p, lang, eager = false } = Astro.props;
const t = T[lang];
const d = p.data;
const v0 = d.variants[0];
const { price, old } = priceOf(p);
const colors = d.variants.map((v) => v.color).filter(Boolean);
const named = d.variants.length === 1 ? pick(lang, d.variants[0].colorName, d.variants[0].colorNameEn) : '';
const scene = isScene(p) || isPhoto(p);
const name = pick(lang, d.title, d.titleEn);
const hasSizes = (d.sizes ?? []).some((s) => s.price);
---
<a class="card reveal" href={href(lang, `/${d.category}/${slugOf(p)}/`)} data-line={d.line} data-colors={colors.join(' ')}>
  <div class:list={['ph', { full: scene }]}>
    <img
      src={smallImg(v0.image)}
      alt={name}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      width="300"
      height="620"
    />
    {old && price && old > price && <span class="badge sale">{t.sale}</span>}
  </div>
  <div class="body">
    <span class="code">{d.model}</span>
    <span class="name">{name}</span>
    <div class="row">
      {price ? (
        <span class="price">
          {hasSizes && <small style="font-weight:400;color:var(--muted);font-size:12px">{t.from} </small>}
          {fmtPrice(price, lang)}
          {old && old > price && <del>{fmtPrice(old, lang)}</del>}
        </span>
      ) : (
        <span class="price ask">{t.askPrice}</span>
      )}
      {named && (
        <span class="dots"><i style={`background-image:url(${swatchOf(d.variants[0])})`} /><small>{named}</small></span>
      )}
      {colors.length > 1 && (
        <span class="dots" aria-label={colors.map((c) => colorName(c, lang)).join('، ')}>
          {d.variants.filter((v) => v.color).slice(0, 4).map((v) => <i style={`background-image:url(${swatchOf(v)})`} />)}
          {colors.length > 4 && <small>+{colors.length - 4}</small>}
        </span>
      )}
    </div>
  </div>
</a>
